<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_multi_vendor" model="ir.ui.view">
        <field name="name">purchase.order.form.multi.vendor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="vendor_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       placeholder="Add additional vendors..."/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Bids" name="bids">
                    <field name="bid_ids">
                        <list editable="bottom" decoration-success="is_winner == True">
                            <field name="vendor_id"/>
                            <field name="price"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="notes"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'won'"
                                   decoration-danger="state == 'lost'"/>
                            <button name="action_select_as_winner"
                                    type="object"
                                    string="Select as Winner"
                                    class="btn-primary"
                                    invisible="state != 'submitted'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
